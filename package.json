{
  "name": "slideforge-figma-plugin",
  "version": "1.0.0",
  "description": "SlideForge — Build Figma Slides from a JSON spec, with SmartAnimate transitions",
  "scripts": {
    "build": "node build.ts",
    "watch": "node build.ts --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/ui",
    "check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-auto-chain.mts"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.139.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "@types/node": "^22.0.0"
  },
  "keywords": ["figma", "plugin", "slides", "motionGraphics", "smartAnimate"],
  "license": "MIT",
  "engines": { "node": ">=22.18" }
}
