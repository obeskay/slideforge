{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "preserve",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@figma/plugin-typings", "./node_modules/@types"],
    "outDir": "./dist"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "build.ts", "src/ui"]
}
